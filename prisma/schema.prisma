generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Favorite_productId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Favorite_userId_fkey")

  @@unique([userId, productId], map: "Favorite_userId_productId_key")
  @@index([productId], map: "Favorite_productId_fkey")
}

model order {
  id              Int         @id @default(autoincrement())
  userId          Int?
  customerName    String
  email           String
  phone           String
  address         String      @db.Text
  totalAmount     Float
  // --- Livraison (Priorité 2) : zone choisie + frais recalculés côté serveur ---
  deliveryZone    String?
  deliveryFee     Float       @default(0)
  status          String      @default("EN_ATTENTE")
  isReadByManager Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  // --- Module de paiement (Projet FANAKA) ---
  paymentStatus   String      @default("PENDING") // PENDING | PAID | A_LA_LIVRAISON | FAILED
  paymentMethod   String?     // MONEGASY | VISA | MASTERCARD | PAYPAL | COD
  paymentRef      String?     @unique(map: "Order_paymentRef_key") // Jeton public de la page de paiement
  stockDeducted   Boolean     @default(false) // Garde-fou anti double-décrément
  // --- Annulation / remboursement (back-office) ---
  cancelReason    String?     @db.Text // Motif saisi par l'administrateur, repris dans l'email client
  cancelledAt     DateTime?
  user            user?       @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  orderitem       orderitem[]
  payment         payment?

  @@index([userId], map: "Order_userId_fkey")
}

model payment {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique(map: "Payment_orderId_key")
  method       String // MONEGASY | VISA | MASTERCARD | PAYPAL | COD
  status       String    @default("PENDING") // PENDING | REQUIRES_ACTION | PROCESSING | PAID | FAILED | CANCELLED
  amount       Float
  currency     String    @default("MGA")
  reference    String    @unique(map: "Payment_reference_key") // Référence interne de la transaction (NDT-...)
  providerRef  String? // Identifiant de transaction renvoyé par la passerelle (simulée)
  isSandbox    Boolean   @default(true)
  errorMessage String?   @db.Text
  metadata     String?   @db.Text // JSON : carte masquée, MSISDN, email PayPal, opérateur...
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  paidAt       DateTime?
  order        order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Payment_orderId_fkey")
  event        paymentevent[]
}

// --- Journal des transactions (Projet FANAKA) ---
// Trace horodatée de CHAQUE étape d'une transaction : initiation, action requise,
// redirection, encaissement, échec, annulation, et réception d'un webhook de test.
// Sert de piste d'audit consultable depuis le back-office (/admin/payments).
model paymentevent {
  id         Int      @id @default(autoincrement())
  paymentId  Int
  /// INITIATED | REQUIRES_ACTION | REDIRECTED | CONFIRMED | PAID | FAILED | CANCELLED | WEBHOOK_RECEIVED | WEBHOOK_REJECTED
  type       String
  /// Source de l'événement : SYSTEM (flux applicatif) | WEBHOOK (rappel passerelle) | ADMIN (action back-office)
  source     String   @default("SYSTEM")
  /// Méthode concernée, dupliquée pour filtrer le journal sans jointure.
  method     String
  /// Statut de la transaction APRÈS application de l'événement.
  status     String
  message    String?  @db.Text
  /// Charge utile JSON reçue ou émise (masquée : jamais de PAN complet ni de CVC).
  payload    String?  @db.Text
  createdAt  DateTime @default(now())
  payment    payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "PaymentEvent_paymentId_fkey")

  @@index([paymentId], map: "PaymentEvent_paymentId_fkey")
  @@index([createdAt], map: "PaymentEvent_createdAt_idx")
}

// --- Journal d'audit du back-office (Traçabilité) ---
// Trace horodatée de CHAQUE action d'administration ayant modifié la boutique :
// qui, quoi, sur quel objet, et ce qui a changé. Écriture seule — le journal n'est
// jamais modifié ni supprimé par l'application, c'est ce qui lui donne sa valeur.
model auditlog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  /// E-mail de l'administrateur auteur de l'action (identité au moment des faits).
  actorEmail  String
  actorId     Int?
  /// Clé canonique de l'action, ex. « product.delete », « order.status ».
  action      String
  /// Famille d'objet concernée : product | order | quote | review | user | category | payment
  entity      String
  /// Identifiant de l'objet touché (chaîne : certaines entités n'ont pas d'id numérique).
  entityId    String?
  /// Désignation lisible de la cible, ex. « Canapé Ambatolampy » ou « CMD #42 ».
  label       String?  @db.Text
  /// Résumé humain de ce qui a changé, affiché tel quel dans le journal.
  summary     String?  @db.Text
  /// Détail structuré (JSON) : valeurs avant/après, motif, options cochées…
  metadata    String?  @db.Text

  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([entity], map: "AuditLog_entity_idx")
  @@index([actorEmail], map: "AuditLog_actorEmail_idx")
}

model orderitem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  price     Float
  quantity  Int
  order     order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product   product? @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model product {
  id          Int         @id @default(autoincrement())
  name        String
  description String      @db.Text
  price       Float
  category    String
  imageUrl    String?     @db.LongText
  createdAt   DateTime    @default(now())
  stock       Int         @default(0)
  updatedAt   DateTime    @updatedAt
  subcategory String?
  /// Moyenne des avis APPROUVÉS, recalculée par lib/ratings.ts. `null` = aucun avis publié.
  /// Jamais saisie à la main : sans quoi la note affichée cesserait de refléter les avis.
  rating      Decimal?    @db.Decimal(2, 1)
  favorite    favorite[]
  orderitem   orderitem[]
  review      review[]
}

// --- Taxonomie du catalogue (Priorité : CRUD complet produits ET catégories) ---
// Les produits référencent la catégorie/sous-catégorie par leur nom (String).
// Ces tables pilotent l'arborescence officielle depuis le back-office.
model category {
  id          Int           @id @default(autoincrement())
  name        String        @unique(map: "Category_name_key")
  createdAt   DateTime      @default(now())
  subcategory subcategory[]
}

model subcategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  createdAt  DateTime @default(now())
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "Subcategory_categoryId_fkey")

  @@unique([categoryId, name], map: "Subcategory_categoryId_name_key")
  @@index([categoryId], map: "Subcategory_categoryId_fkey")
}

model quote {
  id            Int       @id @default(autoincrement())
  customerName  String
  email         String
  phone         String?
  details       String    @db.Text
  dimensions    String?
  status        String    @default("EN_ATTENTE")
  createdAt     DateTime  @default(now())
  imageUrl      String?   @db.LongText
  proposedPrice     Float?
  adminResponse     String?   @db.Text
  proposedAt        DateTime?
  clientDecision    String?   // Réponse du client à la proposition : "ACCEPTE" ou "REFUSE"
  clientResponse    String?   @db.Text // Message libre du client
  clientRespondedAt DateTime?
  responseToken     String?   @unique(map: "Quote_responseToken_key") // Jeton du lien de réponse par email
}

model user {
  id        Int        @id @default(autoincrement())
  firstName String?
  lastName  String?
  email     String     @unique(map: "User_email_key")
  // Optionnel : les comptes créés via Google (OAuth) n'ont pas de mot de passe local.
  password  String?
  image     String?    @db.LongText
  // Fournisseur d'authentification : "credentials" (email/mot de passe) ou "google".
  provider  String     @default("credentials")
  address   String?
  country   String?
  role      String     @default("USER")
  createdAt DateTime   @default(now())
  // --- Double authentification TOTP (RFC 6238) ---
  // Le secret n'est JAMAIS stocké en clair : il est chiffré (AES-256-GCM) par lib/two-factor.ts.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @db.Text
  /// Secret d'un appairage commencé mais pas encore confirmé par un premier code valide.
  twoFactorPendingSecret String? @db.Text
  /// Codes de secours à usage unique (JSON d'empreintes bcrypt) — jamais lisibles après génération.
  twoFactorRecoveryCodes String? @db.Text
  twoFactorEnabledAt     DateTime?
  /// Dernier pas de temps TOTP consommé : interdit de rejouer deux fois le même code.
  twoFactorLastStep      Int?
  // --- Réinitialisation de mot de passe (jeton haché + expiration) ---
  resetToken       String?   @db.Text
  resetTokenExpiry DateTime?
  favorite  favorite[]
  order     order[]
  review      review[]
}

model review {
  id           Int       @id @default(autoincrement())
  rating       Int      // Note de 1 à 5 donnée par le client
  comment      String    @db.Text // Le texte du commentaire
  createdAt    DateTime  @default(now())
  productId    Int
  userId       Int
  adminReply   String?   @db.Text // Réponse publique de la boutique Ndanty
  adminReplyAt DateTime?

  // --- Modération (file d'attente de validation) ---
  // Un avis n'est JAMAIS public tant qu'un administrateur ne l'a pas approuvé.
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  moderatedAt     DateTime?
  moderatedBy     String?   // E-mail de l'administrateur ayant tranché (traçabilité)
  rejectionReason String?   @db.Text // Motif interne du refus

  // Relations conformes aux normes de ton schéma actuel
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Review_productId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Review_userId_fkey")

@@index([productId], map: "Review_productId_fkey")
@@index([userId], map: "Review_userId_fkey")
@@index([status], map: "Review_status_idx")
}